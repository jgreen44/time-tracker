{
  "name": "time-tracker",
  "version": "1.0.0",
  "description": "Simple Mac menu bar app for tracking software development time",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "mkdir -p dist/renderer && cp src/renderer/index.html dist/renderer/index.html && cp node_modules/flatpickr/dist/flatpickr.min.css dist/renderer/flatpickr.min.css && cp node_modules/flatpickr/dist/flatpickr.min.js dist/renderer/flatpickr.min.js",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "flatpickr": "^4.6.13",
    "menubar": "^9.5.2"
  },
  "devDependencies": {
    "@types/flatpickr": "^3.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.jasongreen.timetracker",
    "productName": "Time Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    }
  }
}
