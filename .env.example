# Copy this file to .env and fill in your values.
# .env is gitignored – never commit real credentials.
#
# Turso cloud database (optional – leave blank for local-only SQLite)
# Setup: https://turso.tech
#   turso db create time-tracker
#   turso db show time-tracker --url      → TURSO_DATABASE_URL
#   turso db tokens create time-tracker   → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
